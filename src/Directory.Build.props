<Project>
    <PropertyGroup>
        <!-- NuGet Package Info -->
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <PackageId>$(MSBuildProjectName)</PackageId>
        <!-- The title is searched by NuGet with a higher weight than the description; the ID alone gives no separate "mediator" word. -->
        <Title>$(MSBuildProjectName): free mediator for .NET</Title>
        <Version>2.2.2</Version>
        <Authors>Andrea Ficarra</Authors>
        <Copyright>Copyright © 2026 Andrea Ficarra</Copyright>
        <Description>AnyMediator (formerly OpenMediatR) is a free, open-source (Apache-2.0) in-process mediator for .NET and a MediatR alternative with a MediatR-compatible API: requests, streaming requests, notifications, pipeline behaviors, pre/post-processors, exception handlers/actions and pluggable notification sinks. Independent project, not affiliated with or endorsed by MediatR or Lucky Penny Software.</Description>
        <PackageProjectUrl>https://adiakys.github.io/AnyMediator/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Adiakys/AnyMediator</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReleaseNotes>
2.2.2: package metadata only. No code change.
- Package title "AnyMediator: free mediator for .NET" and new tags (mediator-pattern, in-process, free) so NuGet search finds the package for mediator queries.
        </PackageReleaseNotes>
        <PackageTags>mediator;mediator-pattern;in-process;free;anymediator;openmediatr;mediatr;mediatr-alternative;cqrs;pipeline;notifications;request-response;streaming;messaging;dotnet;open-source;apache-2.0</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        
        <!-- Ship XML docs in the package so IntelliSense and coding agents can read the API documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Build and Publish Settings -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    </PropertyGroup>

    <ItemGroup>
        <!-- Optional: Additional files for the NuGet package -->
        <None Include="$(MSBuildThisFileDirectory)\..\LICENSE" Pack="true" PackagePath="" />
        <None Include="$(MSBuildThisFileDirectory)\..\README.md" Pack="true" PackagePath="" />
        <None Include="$(MSBuildThisFileDirectory)\..\icon.png" Pack="true" PackagePath="" />
    </ItemGroup>
</Project>
